---
import '../../design-system/styles.css';
const base = import.meta.env.BASE_URL;
const { sample } = Astro.props;
---
<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Volna Web App</title>
    <link rel="icon" href={`${base}assets/volna.svg`} type="image/svg+xml" />
  </head>
  <body data-sample={sample ? 'true' : 'false'}>
    <main id="viewer" aria-label="Volna viewer">
      <div id="viewer-status" role="status">Loading the Volna viewer…</div>
      <div id="viewer-error" role="alert" hidden></div>
      {!sample && <nav id="viewer-actions" aria-label="Recording controls">
        <button class="v-btn v-btn--sm" id="open-recording" type="button" disabled>Open recording</button>
        <button class="v-btn v-btn--sm" id="load-sample" type="button" disabled>Load sample</button>
      </nav>}
      <noscript><p>Enable JavaScript to run the viewer. The <a href={`${base}docs/`}>engineering documentation</a> remains available.</p></noscript>
    </main>
    <input id="recording-file" type="file" accept=".vtr,.fst" aria-label="Open a local recording" hidden />
    <script type="module" src={`${base}viewer/host.js`}></script>
  </body>
</html>
<style is:global>
  html, body { width: 100%; height: 100%; margin: 0; overflow: hidden; background: var(--bg); color: var(--text-1); }
  #viewer { position: relative; z-index: 1; width: 100%; height: 100%; pointer-events: none; }
  #viewer > * { pointer-events: auto; }
  body > canvas { position: absolute; inset: 0; }
  #viewer-status, #viewer-error { position: absolute; z-index: 1; inset: auto 1rem 1rem; width: max-content; max-width: calc(100% - 2rem); padding: .75rem 1rem; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--bg-raised); color: var(--text-1); font: var(--text-sm) var(--font-sans); }
  #viewer-error { border-color: var(--danger); }
  #viewer-actions { position: absolute; z-index: 1; right: 1rem; bottom: 1rem; display: flex; flex-wrap: wrap; gap: .5rem; }
  #viewer-status[hidden], #viewer-error[hidden] { display: none; }
</style>
