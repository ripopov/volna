{
  "name": "volna-docs",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "npm run build:viewer && astro dev",
    "build:viewer": "node scripts/build-viewer.mjs",
    "check": "astro check",
    "build": "npm run build:viewer && astro build && node scripts/check-links.mjs",
    "preview": "astro preview",
    "test": "node --test ../volna/tools/build-web.test.mjs tests/conversion.test.mjs && node tests/site.mjs && node tests/web-imports.mjs && node tests/web-sorting.mjs",
    "test:imports": "node --test tests/conversion.test.mjs && node tests/web-imports.mjs",
    "test:sorting": "node tests/web-sorting.mjs"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.5",
    "@astrojs/markdown-remark": "7.3.0",
    "astro": "7.3.5",
    "rehype-mermaid": "^3.0.0",
    "mdast-util-from-markdown": "2.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "typescript": "^5.9.3",
    "playwright": "^1.58.2",
    "@axe-core/playwright": "^4.11.1"
  }
}
