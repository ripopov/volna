{
  "name": "volna",
  "displayName": "Volna Waveform Viewer",
  "description": "View VTR and FST recordings with the GPUI waveform viewer and a bundled trace server.",
  "version": "0.1.2",
  "publisher": "vtr",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=24"
  },
  "categories": [
    "Visualization"
  ],
  "activationEvents": [],
  "main": "./extension.js",
  "extensionKind": [
    "workspace"
  ],
  "contributes": {
    "commands": [
      {
        "command": "volna.open",
        "title": "Volna: Open Waveform Viewer"
      },
      {
        "command": "volna.openSettings",
        "title": "Volna: Open Settings"
      },
      {
        "command": "volna.undo",
        "title": "Volna: Undo"
      },
      {
        "command": "volna.redo",
        "title": "Volna: Redo"
      },
      {
        "command": "volna.splitRight",
        "title": "Volna: Split Right"
      },
      {
        "command": "volna.splitDown",
        "title": "Volna: Split Down"
      },
      {
        "command": "volna.newPanel",
        "title": "Volna: New Waveform Tab"
      },
      {
        "command": "volna.closePanel",
        "title": "Volna: Close Panel"
      },
      {
        "command": "volna.focusNextPanel",
        "title": "Volna: Focus Next Panel"
      },
      {
        "command": "volna.focusPrevPanel",
        "title": "Volna: Focus Previous Panel"
      },
      {
        "command": "volna.toggleViewportLink",
        "title": "Volna: Toggle Viewport Link"
      },
      {
        "command": "volna.toggleCursorLink",
        "title": "Volna: Toggle Cursor Link"
      },
      {
        "command": "volna.nextCycle",
        "title": "Volna: Next Cycle of the Selected Clock"
      },
      {
        "command": "volna.prevCycle",
        "title": "Volna: Previous Cycle of the Selected Clock"
      },
      {
        "command": "volna.toggleCycleOrigin",
        "title": "Volna: Set or Reset the Cycle Origin at the Cursor"
      },
      {
        "command": "volna.nextMarker",
        "title": "Volna: Next Marker"
      },
      {
        "command": "volna.prevMarker",
        "title": "Volna: Previous Marker"
      },
      {
        "command": "volna.jumpBack",
        "title": "Volna: Return to Before the Last Jump"
      },
      {
        "command": "volna.setReference",
        "title": "Volna: Measure from Cursor"
      },
      {
        "command": "volna.clearReference",
        "title": "Volna: Clear Reference"
      },
      {
        "command": "volna.zoomToMeasurement",
        "title": "Volna: Zoom to Measurement"
      },
      {
        "command": "volna.markerNavigator",
        "title": "Volna: Find Marker…"
      },
      {
        "command": "volna.colorDefault",
        "title": "Volna: Color: Default"
      },
      {
        "command": "volna.colorBlue",
        "title": "Volna: Color: Blue"
      },
      {
        "command": "volna.colorCyan",
        "title": "Volna: Color: Cyan"
      },
      {
        "command": "volna.colorViolet",
        "title": "Volna: Color: Violet"
      },
      {
        "command": "volna.colorPink",
        "title": "Volna: Color: Pink"
      },
      {
        "command": "volna.colorGrey",
        "title": "Volna: Color: Grey"
      },
      {
        "command": "volna.focusPanel1",
        "title": "Volna: Focus Panel 1"
      },
      {
        "command": "volna.focusPanel2",
        "title": "Volna: Focus Panel 2"
      },
      {
        "command": "volna.focusPanel3",
        "title": "Volna: Focus Panel 3"
      },
      {
        "command": "volna.focusPanel4",
        "title": "Volna: Focus Panel 4"
      },
      {
        "command": "volna.focusPanel5",
        "title": "Volna: Focus Panel 5"
      },
      {
        "command": "volna.focusPanel6",
        "title": "Volna: Focus Panel 6"
      },
      {
        "command": "volna.focusPanel7",
        "title": "Volna: Focus Panel 7"
      },
      {
        "command": "volna.focusPanel8",
        "title": "Volna: Focus Panel 8"
      },
      {
        "command": "volna.focusPanel9",
        "title": "Volna: Focus Panel 9"
      },
      {
        "command": "volna.openWorkspace",
        "title": "Volna: Open Workspace…"
      },
      {
        "command": "volna.saveWorkspace",
        "title": "Volna: Save Workspace"
      },
      {
        "command": "volna.saveWorkspaceAs",
        "title": "Volna: Save Workspace As…"
      }
    ],
    "customEditors": [
      {
        "viewType": "volna.waveform",
        "displayName": "Volna Waveform Viewer",
        "selector": [
          {
            "filenamePattern": "*.vtr"
          },
          {
            "filenamePattern": "*.fst"
          }
        ],
        "priority": "default"
      }
    ],
    "keybindings": [
      {
        "command": "volna.undo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "activeCustomEditorId == volna.waveform && !inputFocus"
      },
      {
        "command": "volna.redo",
        "key": "ctrl+shift+z",
        "mac": "cmd+shift+z",
        "when": "activeCustomEditorId == volna.waveform && !inputFocus"
      },
      {
        "command": "volna.redo",
        "key": "ctrl+y",
        "mac": "cmd+shift+z",
        "when": "activeCustomEditorId == volna.waveform && !inputFocus"
      },
      {
        "command": "volna.splitRight",
        "key": "ctrl+\\",
        "mac": "cmd+\\",
        "when": "activeCustomEditorId == volna.waveform && !inputFocus"
      },
      {
        "command": "volna.splitDown",
        "key": "ctrl+shift+\\",
        "mac": "cmd+shift+\\",
        "when": "activeCustomEditorId == volna.waveform && !inputFocus"
      },
      {
        "command": "volna.newPanel",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "activeCustomEditorId == volna.waveform && !inputFocus"
      },
      {
        "command": "volna.closePanel",
        "key": "ctrl+w",
        "mac": "cmd+w",
        "when": "activeCustomEditorId == volna.waveform && !inputFocus"
      },
      {
        "command": "volna.focusNextPanel",
        "key": "ctrl+tab",
        "mac": "ctrl+tab",
        "when": "activeCustomEditorId == volna.waveform && !inputFocus"
      },
      {
        "command": "volna.focusPrevPanel",
        "key": "ctrl+shift+tab",
        "mac": "ctrl+shift+tab",
        "when": "activeCustomEditorId == volna.waveform && !inputFocus"
      },
      {
        "command": "volna.focusPanel1",
        "key": "ctrl+1",
        "mac": "cmd+1",
        "when": "activeCustomEditorId == volna.waveform && !inputFocus"
      },
      {
        "command": "volna.focusPanel2",
        "key": "ctrl+2",
        "mac": "cmd+2",
        "when": "activeCustomEditorId == volna.waveform && !inputFocus"
      },
      {
        "command": "volna.focusPanel3",
        "key": "ctrl+3",
        "mac": "cmd+3",
        "when": "activeCustomEditorId == volna.waveform && !inputFocus"
      },
      {
        "command": "volna.focusPanel4",
        "key": "ctrl+4",
        "mac": "cmd+4",
        "when": "activeCustomEditorId == volna.waveform && !inputFocus"
      },
      {
        "command": "volna.focusPanel5",
        "key": "ctrl+5",
        "mac": "cmd+5",
        "when": "activeCustomEditorId == volna.waveform && !inputFocus"
      },
      {
        "command": "volna.focusPanel6",
        "key": "ctrl+6",
        "mac": "cmd+6",
        "when": "activeCustomEditorId == volna.waveform && !inputFocus"
      },
      {
        "command": "volna.focusPanel7",
        "key": "ctrl+7",
        "mac": "cmd+7",
        "when": "activeCustomEditorId == volna.waveform && !inputFocus"
      },
      {
        "command": "volna.focusPanel8",
        "key": "ctrl+8",
        "mac": "cmd+8",
        "when": "activeCustomEditorId == volna.waveform && !inputFocus"
      },
      {
        "command": "volna.focusPanel9",
        "key": "ctrl+9",
        "mac": "cmd+9",
        "when": "activeCustomEditorId == volna.waveform && !inputFocus"
      },
      {
        "command": "volna.saveWorkspace",
        "key": "ctrl+s",
        "mac": "cmd+s",
        "when": "activeCustomEditorId == volna.waveform && !inputFocus"
      },
      {
        "command": "volna.saveWorkspaceAs",
        "key": "ctrl+shift+s",
        "mac": "cmd+shift+s",
        "when": "activeCustomEditorId == volna.waveform && !inputFocus"
      }
    ],
    "configuration": {
      "properties": {
        "volna.appearance.analogWaveWidth": {
          "default": 1.25,
          "markdownDescription": "Width of analog waveform curves in logical pixels at interface zoom 1. Scales with interface zoom; dense envelopes remain one pixel wide.",
          "maximum": 4,
          "minimum": 1,
          "type": "number"
        },
        "volna.appearance.digitalWaveWidth": {
          "default": 1,
          "markdownDescription": "Width of digital waveform levels, transitions, bus outlines and event stems in logical pixels. Independent of interface zoom.",
          "maximum": 4,
          "minimum": 1,
          "type": "number"
        },
        "volna.appearance.waveSpacing": {
          "default": 5,
          "markdownDescription": "Blank space above and below each waveform in logical pixels at interface zoom 1. Scales with interface zoom without changing row heights. Reduced in short rows to leave room for the trace.",
          "maximum": 10,
          "minimum": 0,
          "type": "number"
        },
        "volna.appearance.zoom": {
          "default": 1,
          "markdownDescription": "Scale the whole interface: chrome, sidebars, the settings editor and the wave table with its rows and text. 1 is the design size. `⌘=` / `⌘-` step it, `⌘0` resets it. Time-axis zoom of the waves is unrelated.",
          "maximum": 3,
          "minimum": 0.5,
          "type": "number"
        },
        "volna.hierarchy.activityIndex": {
          "default": "ask",
          "enum": [
            "ask",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "Ask",
            "Always",
            "Never"
          ],
          "markdownDescription": "Build an activity index for a trace that has none: choose ask to offer Build and Not now, always to start a background build, or never to hide the offer. The trace remains usable while building. Indexes enable exact scope activity meters and are cached beside the trace or in the user cache.",
          "type": "string"
        },
        "volna.memory.budgetMiB": {
          "default": 512,
          "markdownDescription": "Loaded trace data the viewer may hold, in MiB: the open trace, signal histories, tracks and table workspace. Raising it applies at once; lowering it refuses new loads until enough is removed. It does not bound total process or browser memory.",
          "maximum": 262144,
          "minimum": 1,
          "type": "integer"
        },
        "volna.memory.objectMiB": {
          "default": 256,
          "markdownDescription": "Largest single signal history, track or remote metadata object the viewer loads, in MiB. It applies to the next load; a remote trace applies it when reopened.",
          "maximum": 262144,
          "minimum": 1,
          "type": "integer"
        },
        "volna.panels.linkByDefault": {
          "default": true,
          "markdownDescription": "New waveform panels follow the shared viewport and cursor. Each panel can still unlink from its header.",
          "type": "boolean"
        },
        "volna.remote.serverPath": {
          "default": "",
          "markdownDescription": "Path to `volna-server` on the workspace host. Empty uses the binary bundled with the extension. Reopen the trace to apply.",
          "scope": "machine",
          "type": "string"
        },
        "volna.transaction.detailItems": {
          "default": 20,
          "markdownDescription": "Maximum attributes, stages, events, or related records listed in each section of the Transaction panel. The admitted byte budget may truncate earlier.",
          "maximum": 1000,
          "minimum": 1,
          "type": "integer"
        },
        "volna.waves.animation": {
          "default": "on",
          "enum": [
            "on",
            "reduced",
            "off"
          ],
          "enumDescriptions": [
            "On",
            "Reduced",
            "Off"
          ],
          "markdownDescription": "Animate pan and zoom. `reduced` keeps the motion but shortens it; `off` jumps.",
          "type": "string"
        },
        "volna.waves.snapPixels": {
          "default": 6,
          "markdownDescription": "Clicks in the waves snap the cursor to an edge within this many pixels. 0 disables snapping.",
          "maximum": 24,
          "minimum": 0,
          "type": "integer"
        },
        "volna.workspace.autosave": {
          "default": "sidecar",
          "enum": [
            "sidecar",
            "vscode",
            "off"
          ],
          "enumDescriptions": [
            "Beside the trace",
            "VS Code workspace storage",
            "Off"
          ],
          "markdownDescription": "Save the session beside the trace as `<trace>.volna.json`, in VS Code workspace storage, or disable workspace persistence. Reopen the trace to apply.",
          "scope": "resource",
          "type": "string"
        }
      },
      "title": "Volna"
    },
    "menus": {
      "editor/title": [
        {
          "command": "volna.openWorkspace",
          "when": "activeCustomEditorId == volna.waveform",
          "group": "volna.workspace"
        },
        {
          "command": "volna.saveWorkspace",
          "when": "activeCustomEditorId == volna.waveform",
          "group": "volna.workspace"
        },
        {
          "command": "volna.saveWorkspaceAs",
          "when": "activeCustomEditorId == volna.waveform",
          "group": "volna.workspace"
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ripopov/volna.git"
  },
  "scripts": {
    "settings": "node scripts/settings.mjs",
    "check": "npm run check:format && node scripts/settings.mjs --check",
    "test": "node --test commands.test.cjs workspace.test.cjs trace-host.test.cjs theme.test.mjs",
    "test:package": "python3 -m unittest discover -s . -p test_package_vsix.py",
    "test:vsix": "node --test vsix.test.mjs",
    "build": "node scripts/build.mjs",
    "package": "python3 package_vsix.py",
    "check:format": "prettier --check \"*.js\" \"*.cjs\" \"*.mjs\" \"scripts/*.mjs\" \"*.css\" package.json ../volna/tools/build-web.mjs",
    "format": "prettier --write \"*.js\" \"*.cjs\" \"*.mjs\" \"scripts/*.mjs\" \"*.css\" package.json ../volna/tools/build-web.mjs"
  },
  "devDependencies": {
    "@vscode/vsce": "4.0.0",
    "playwright": "1.58.2",
    "pngjs": "7.0.0",
    "prettier": "3.6.2"
  }
}
